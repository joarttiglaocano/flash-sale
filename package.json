{
  "name": "flash-sale",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web & wait",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "dev:consumer": "npm run dev:consumer --workspace=server",
    "migrate": "npm run migrate --workspace=server",
    "rebuild": "npm run rebuild --workspace=server --",
    "build": "npm run build --workspace=server && npm run build --workspace=web",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=web",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server --",
    "verify": "npm run verify --workspace=server --",
    "stress": "docker run --rm -i --add-host=host.docker.internal:host-gateway -v ./k6:/scripts -e BASE_URL=http://host.docker.internal:3000 grafana/k6 run /scripts/flash-sale.js",
    "verify:pg": "npm run verify:pg --workspace=server",
    "failback": "npm run failback --workspace=server"
  },
  "engines": {
    "node": ">=22"
  }
}
