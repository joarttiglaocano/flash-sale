# Server
PORT=3000
REDIS_URL=redis://localhost:6379

# Durable order store (v2) — matches docker-compose defaults
DATABASE_URL=postgres://flash:flash@localhost:5432/flashsale
# Write-behind consumer tuning (defaults shown):
# CONSUMER_NAME=consumer-1
# CONSUMER_BATCH_SIZE=100
# CONSUMER_BLOCK_MS=5000

# Sale configuration
SALE_ID=default
INITIAL_STOCK=5000

# Sale window — pick ONE style:
# 1) Default: the seed script starts the sale immediately and runs it
#    for this many minutes.
SALE_DURATION_MINUTES=10
# 2) Explicit window (uncomment both, ISO 8601):
# SALE_START=2026-08-01T10:00:00Z
# SALE_END=2026-08-01T12:00:00Z
